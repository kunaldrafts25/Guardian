# Guardian local backend configuration example
# Do not commit real credentials or production keys.

AWS_DEFAULT_REGION=ap-south-1

# Cognito federation. Production mobile login uses Cognito managed login with
# Google as the identity provider and authorization-code + PKCE.
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_public_cognito_mobile_client_id
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Local-only backend testing may provide the Google Maps web-service key
# directly. AWS staging/production MUST use GoogleMapsServerApiKeySecretArn
# and GOOGLE_MAPS_SERVER_API_KEY_SECRET_ARN instead.
GOOGLE_MAPS_SERVER_API_KEY=local_development_only_key

# DynamoDB
DYNAMODB_USERS_TABLE=guardian-users
DYNAMODB_INCIDENTS_TABLE=guardian-incidents
DYNAMODB_EVENTS_TABLE=guardian-incident-events
DYNAMODB_RESPONDERS_TABLE=guardian-responders
DYNAMODB_MISSIONS_TABLE=guardian-missions
DYNAMODB_DEVICE_ENDPOINTS_TABLE=guardian-device-endpoints
DYNAMODB_SESSIONS_TABLE=guardian-sessions
DYNAMODB_AGENT_LEDGER_TABLE=guardian-agent-ledger
DYNAMODB_AGENT_AUTHORIZATIONS_TABLE=guardian-agent-authorizations
DYNAMODB_ABUSE_COUNTERS_TABLE=guardian-abuse-counters
DYNAMODB_ABUSE_REPORTS_TABLE=guardian-abuse-reports

# SNS push platform applications. Trusted-contact cloud SMS is an independent
# emergency channel and is not used for Guardian account login.
SNS_FCM_PLATFORM_ARN=arn:aws:sns:ap-south-1:123456789012:app/GCM/guardian-android
SNS_APNS_PLATFORM_ARN=arn:aws:sns:ap-south-1:123456789012:app/APNS/guardian-ios

# Bedrock advisory model. Deterministic Guardian policy remains authoritative.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Phase 5 local/testing controls. Never enable dev mode in production.
GUARDIAN_DEV_MODE=false
INCIDENT_RETENTION_DAYS=90
