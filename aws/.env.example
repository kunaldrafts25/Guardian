# Guardian AWS Full-Stack Configuration
# Copy this to e:\Guardian\aws\.env and fill in your values
# Or put in e:\Guardian\.env (root level)

# ─────────────────────────────────────────────────────────────────────────────
# AWS Core Credentials
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1

# ─────────────────────────────────────────────────────────────────────────────
# Amazon Cognito (Auth — replaces Firebase Auth)
# ─────────────────────────────────────────────────────────────────────────────
# Create a User Pool in AWS Console → Cognito → User Pools
# Enable Phone Number sign-in + SMS MFA
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_app_client_id
# Leave blank if your app client has no secret
COGNITO_CLIENT_SECRET=your_cognito_client_secret_optional

# ─────────────────────────────────────────────────────────────────────────────
# AWS DynamoDB (Database — replaces Firestore)
# ─────────────────────────────────────────────────────────────────────────────
# Table will be auto-created by the setup script. Just set the names.
DYNAMODB_USERS_TABLE=guardian-users
DYNAMODB_INCIDENTS_TABLE=guardian-incidents
DYNAMODB_EVENTS_TABLE=guardian-incident-events
DYNAMODB_RESPONDERS_TABLE=guardian-responders

# ─────────────────────────────────────────────────────────────────────────────
# AWS SNS (targeted push through FCM/APNs, plus trusted-contact SMS)
# ─────────────────────────────────────────────────────────────────────────────
# 1. Create an SNS Platform Application for Android (FCM/GCM)
SNS_FCM_PLATFORM_ARN=arn:aws:sns:ap-south-1:123456789012:app/GCM/guardian-android

# 2. Create an SNS Platform Application for iOS (APNS)
SNS_APNS_PLATFORM_ARN=arn:aws:sns:ap-south-1:123456789012:app/APNS/guardian-ios

# ─────────────────────────────────────────────────────────────────────────────
# Amazon Bedrock (AI Agent)
# ─────────────────────────────────────────────────────────────────────────────
# Options: anthropic.claude-3-haiku-20240307-v1:0 | amazon.nova-micro-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ─────────────────────────────────────────────────────────────────────────────
# Google APIs (Maps + Sign-In — keep these)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY_ANDROID=your_android_maps_key
GOOGLE_MAPS_API_KEY_IOS=your_ios_maps_key
GOOGLE_MAPS_API_KEY_WEB=your_web_maps_key
