<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ═══════════════════════════════════════════════════
	     App Identity
	     ═══════════════════════════════════════════════════ -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Guardian</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>guardian</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>

	<!-- ═══════════════════════════════════════════════════
	     Google Sign-In — OAuth redirect URL scheme
	     Replace REVERSED_CLIENT_ID with the value from
	     GoogleService-Info.plist after Firebase iOS setup
	     ═══════════════════════════════════════════════════ -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.530178096868-90d5lls6prav97gaueu9814dgprlmlm7</string>
			</array>
		</dict>
	</array>

	<!-- Firebase Cloud Messaging -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>


	<!-- ═══════════════════════════════════════════════════
	     PRIVACY USAGE STRINGS — Required or app crashes
	     on first permission request on real iOS device
	     ═══════════════════════════════════════════════════ -->

	<!-- Location — always on for background safety monitoring -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Guardian needs your location to include it in emergency alerts sent to your trusted contacts.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Guardian uses your location in the background to keep emergency alerts accurate even when your screen is off.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Guardian uses your location in the background to provide accurate location in emergency alerts.</string>

	<!-- Microphone — for voice SOS triggers and audio threat detection -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Guardian uses the microphone when you enable and use voice SOS commands.</string>

	<!-- Camera — for environment safety classification and evidence capture -->
	<key>NSCameraUsageDescription</key>
	<string>Guardian can capture photos or video as evidence during an emergency alert.</string>

	<!-- Contacts — for emergency contact phone number validation -->
	<key>NSContactsUsageDescription</key>
	<string>Guardian can import phone numbers from your contacts to set up your emergency contact list faster.</string>

	<!-- Motion — for shake and fall detection -->
	<key>NSMotionUsageDescription</key>
	<string>Guardian uses motion sensors when you enable shake gestures for emergency alerts.</string>

	<!-- Face ID — for biometric lock of sensitive settings -->
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to quickly authenticate and access Guardian settings.</string>

	<!-- ═══════════════════════════════════════════════════
	     BACKGROUND MODES — Critical for safety monitoring
	     ═══════════════════════════════════════════════════ -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>audio</string>
	</array>

	<!-- ═══════════════════════════════════════════════════
	     UI Configuration
	     ═══════════════════════════════════════════════════ -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
