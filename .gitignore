# ============================================================
# Guardian Safety App — .gitignore
# ============================================================

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.dart_snapshot
*.dart_flow
doc/api/

# --- Generated files ---
# Note: .g.dart files are committed so CI does not need to run build_runner for analyze.
# Run: dart run build_runner build --delete-conflicting-outputs  to regenerate locally.
*.freezed.dart
*.gr.dart
lib/generated/
lib/**/*.freezed.dart

# --- Android ---
android/.gradle
android/.kotlin/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/key.properties
android/*.jks
android/**/*.jks
**/android/app/google-services.json
**/android/app/src/*/google-services.json

# --- iOS / macOS ---
ios/Flutter/flutter_export_environment.sh
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Pods/
ios/Podfile.lock
**/ios/Runner/GoogleService-Info.plist
*.ipa

# --- Web ---

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.env
env.dart
# firebase_options.dart is committed as a stub (real values injected at runtime via env).
# Replace lib/firebase_options.dart with output of `flutterfire configure` for production.

# --- API Keys ---
android/app/src/main/res/values/google_maps_api.xml
ios/Runner/Config.xcconfig
ios/Runner/GoogleService-Info.plist
GoogleService-Info.plist
google-services.json

# --- Build artifacts ---
*.apk
*.aab
*.ipa
*.zip
*.tar.gz
*.dSYM

# --- IDE ---
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.suo
*.user
.DS_Store
Thumbs.db

# --- Testing & Python ---
coverage/
test/.test_coverage.dart
__pycache__/
*.pyc
.pytest_cache/

# --- Misc ---
pubspec.lock
!pubspec.lock
