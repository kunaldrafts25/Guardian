# Guardian mobile build configuration template
# Do not commit real production credentials, service-account files, or signing keys.

# Guardian AWS API + Cognito managed-login configuration.
AWS_API_ENDPOINT=https://your-api-id.execute-api.ap-south-1.amazonaws.com/Prod
COGNITO_AUTH_DOMAIN=https://your-cognito-domain.auth.ap-south-1.amazoncognito.com
COGNITO_CLIENT_ID=your_public_cognito_mobile_client_id
COGNITO_REDIRECT_URI=guardian://auth/callback

# Google Maps SDK keys are mobile/application-restricted credentials.
# Android production builds read GUARDIAN_GOOGLE_MAPS_ANDROID_API_KEY from the
# build environment. iOS reads GOOGLE_MAPS_IOS_API_KEY from non-committed
# ios/Runner/Config.xcconfig.
GOOGLE_MAPS_API_KEY_ANDROID=your_android_application_restricted_key
GOOGLE_MAPS_API_KEY_IOS=your_ios_bundle_restricted_key

# Firebase is used for Android FCM registration/push transport, not Guardian
# authentication or application data storage.
FIREBASE_API_KEY=your_firebase_mobile_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_ANDROID_APP_ID=your_android_app_id
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_IOS_BUNDLE_ID=com.company.guardian
FIREBASE_STORAGE_BUCKET=your_optional_storage_bucket

# Android release signing values belong in the operator environment/secret store.
GUARDIAN_KEYSTORE_PATH=/secure/path/to/guardian-release.jks
GUARDIAN_KEYSTORE_PASSWORD=replace_me
GUARDIAN_KEY_ALIAS=replace_me
GUARDIAN_KEY_PASSWORD=replace_me
