# Guardian API Keys - Environment Variables Template
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to version control!

# Google Maps API Keys (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY_ANDROID=your_android_key_here
GOOGLE_MAPS_API_KEY_IOS=your_ios_key_here
GOOGLE_MAPS_API_KEY_WEB=your_web_key_here

# Google Sign-In Client ID (OAuth 2.0 Client ID)
GOOGLE_SIGNIN_CLIENT_ID=your_google_signin_client_id_here

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
